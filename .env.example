# Which LLM provider to use: openai or anthropic
LLM_PROVIDER=openai

# Model id sent to the provider.
# For OpenAI testing: gpt-4o-mini
# For Anthropic delivery: copy the current Claude Sonnet model id from console.anthropic.com
LLM_MODEL=gpt-4o-mini

# API keys. Only the key for the active provider is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
