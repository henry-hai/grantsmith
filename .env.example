# Which LLM provider to use: openai or anthropic
LLM_PROVIDER=openai

# Model id sent to the provider.
# For OpenAI testing: gpt-4o-mini
# For Anthropic delivery: copy the current Claude Sonnet model id from console.anthropic.com
LLM_MODEL=gpt-4o-mini

# API keys. Only the key for the active provider is required.
# OpenAI is also used for retrieval embeddings, so OPENAI_API_KEY is needed
# whenever retrieval is active, even if drafting uses Anthropic.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Retrieval (RAG) over the example proposals. All optional, shown with defaults.
# OpenAI embedding model used to embed example chunks and each question.
EMBEDDING_MODEL=text-embedding-3-small
# Number of example chunks retrieved and injected per question.
RAG_TOP_K=5
# Target size of each example chunk, in characters.
CHUNK_SIZE=1000
# Overlap between consecutive chunks, in characters.
CHUNK_OVERLAP=200
